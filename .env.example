# openclaw-control-mcp — example environment file
#
# Copy to one of these locations (checked in this order, first match wins):
#   1. $OPENCLAW_ENV_FILE            — explicit path, overrides everything
#   2. ./.env                        — the directory the server is started from
#   3. ${XDG_CONFIG_HOME:-~/.config}/openclaw-control-mcp/.env
#
# Then lock it down:  chmod 600 .env
#
# Real environment variables always beat file values, so a one-shot
# `OPENCLAW_GATEWAY_TOKEN=… npx openclaw-control-mcp` still wins.
#
# No variable interpolation is performed — values are taken literally.
# Note: OPENCLAW_CONTROL_HOME / XDG_CONFIG_HOME decide *where* this file is
# looked up, so setting them in here has no effect. Export them for real.

# ── Gateway connection ───────────────────────────────────────────────────────
# WebSocket URL of the OpenClaw gateway.
OPENCLAW_GATEWAY_URL=wss://gateway.example.com/ws

# Login token for the gateway (or use OPENCLAW_GATEWAY_PASSWORD instead).
OPENCLAW_GATEWAY_TOKEN=

# OPENCLAW_GATEWAY_PASSWORD=

# ── Device identity (optional — stateless / CI mode) ─────────────────────────
# Set these to skip the on-disk store entirely: the server derives the public
# key + device id from the private key and never writes a secret to disk.
# Get their values from an already-paired install:
#   npx tsx scripts/export-ci-secrets.ts
#
# base64url-encoded 32-byte Ed25519 seed
# OPENCLAW_DEVICE_PRIVATE_KEY=
# device token issued by the gateway after pairing approval
# OPENCLAW_DEVICE_TOKEN=
# OPENCLAW_DEVICE_ROLE=operator
# OPENCLAW_DEVICE_SCOPES=operator.admin,operator.read,operator.write

# ── Behaviour ────────────────────────────────────────────────────────────────
# OPENCLAW_TIMEOUT_MS=30000
# OPENCLAW_RETRY_ATTEMPTS=3
# OPENCLAW_RETRY_BASE_MS=250
# OPENCLAW_DEBUG=1

# ── HTTP transport (optional — stdio is the default) ─────────────────────────
# OPENCLAW_HTTP=1
# OPENCLAW_HTTP_HOST=127.0.0.1
# OPENCLAW_HTTP_PORT=3333
# Required when binding to a non-loopback host.
# OPENCLAW_HTTP_BEARER=
